{
  "name": "flosurf-design-system",
  "version": "0.1.0",
  "private": true,
  "description": "Self-hosted 3-tier W3C DTCG design token system, Style Dictionary v4 pipeline, CI audit gates and agent skills.",
  "type": "module",
  "engines": {
    "node": ">=22.19"
  },
  "bin": {
    "flosurf": "./bin/flosurf.mjs"
  },
  "scripts": {
    "flosurf": "node bin/flosurf.mjs",
    "build": "node bin/flosurf.mjs build",
    "audit:hardcoded": "node scripts/audit-hardcoded.mjs src",
    "audit:contrast": "node scripts/audit-contrast.mjs",
    "audit:states": "node scripts/audit-states.mjs",
    "audit:stress": "node scripts/audit-stress.mjs",
    "audit": "node bin/flosurf.mjs audit",
    "ci": "node bin/flosurf.mjs ci",
    "export": "node bin/flosurf.mjs export",
    "health": "node bin/flosurf.mjs health",
    "sync": "node bin/flosurf.mjs sync",
    "tokens:ingest": "node scripts/ingest-figma-tokens.mjs",
    "audit:flo:contrast": "node scripts/audit-contrast.mjs --pairs audit/flo-contrast-pairs.json --modes day,night",
    "docs": "node scripts/serve.mjs",
    "serve": "node scripts/serve.mjs"
  },
  "devDependencies": {
    "style-dictionary": "^4.4.0"
  }
}
