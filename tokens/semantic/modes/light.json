{
  "color": {
    "$type": "color",
    "bg": {
      "surface": {
        "default": { "$value": "{color.slate.50}" },
        "raised": { "$value": "{color.white}" },
        "sunken": { "$value": "{color.slate.100}" }
      },
      "action": {
        "primary": {
          "default": { "$value": "{color.indigo.600}" },
          "hover": { "$value": "{color.indigo.700}" },
          "active": { "$value": "{color.indigo.800}" },
          "disabled": { "$value": "{color.slate.200}" }
        },
        "secondary": {
          "default": { "$value": "{color.white}" },
          "hover": { "$value": "{color.slate.100}" },
          "active": { "$value": "{color.slate.200}" },
          "disabled": { "$value": "{color.slate.100}" }
        },
        "danger": {
          "default": { "$value": "{color.red.700}" },
          "hover": { "$value": "{color.red.800}" },
          "active": { "$value": "{color.red.900}" },
          "disabled": { "$value": "{color.slate.200}" }
        }
      },
      "feedback": {
        "danger": { "subtle": { "$value": "{color.red.50}" } },
        "success": { "subtle": { "$value": "{color.green.50}" } },
        "warning": { "subtle": { "$value": "{color.amber.50}" } }
      }
    },
    "fg": {
      "default": { "$value": "{color.slate.900}" },
      "muted": { "$value": "{color.slate.600}" },
      "disabled": { "$value": "{color.slate.500}" },
      "on-action": { "$value": "{color.white}" },
      "link": { "$value": "{color.indigo.700}" },
      "danger": { "$value": "{color.red.700}" },
      "success": { "$value": "{color.green.700}" },
      "warning": { "$value": "{color.amber.800}" }
    },
    "border": {
      "subtle": { "$value": "{color.slate.200}" },
      "default": { "$value": "{color.slate.300}" },
      "strong": { "$value": "{color.slate.500}" },
      "focus": { "$value": "{color.indigo.600}" },
      "danger": { "$value": "{color.red.600}" }
    }
  }
}
